{
  "name": "yuzuha-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "React Native shell for the Yuzuha installer-enabled experience",
  "engines": {
    "node": ">=20.19.4 <25"
  },
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "bundle": "npm run bundle:android",
    "bundle:android": "react-native bundle --entry-file index.js --platform android --dev false --bundle-output dist/android.jsbundle --assets-dest dist/android-assets",
    "bundle:ios": "react-native bundle --entry-file index.js --platform ios --dev false --bundle-output dist/ios.jsbundle --assets-dest dist/ios-assets",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "check-bundle": "tsx src/installer/checkBundle.ts"
  },
  "dependencies": {
    "@noble/ciphers": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@op-engineering/op-sqlite": "^17.1.2",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-documents/picker": "^12.0.1",
    "react": "19.2.8",
    "react-native": "0.86.0",
    "react-native-file-access": "^4.0.3",
    "react-native-get-random-values": "^2.0.0",
    "react-native-safe-area-context": "^5.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@react-native-community/cli": "20.2.0",
    "@react-native/babel-preset": "0.86.1",
    "@react-native/jest-preset": "0.86.0",
    "@react-native/metro-config": "0.86.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "jest": "^29.7.0",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
