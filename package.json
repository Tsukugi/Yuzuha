{
  "name": "yuzuha-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "React Native shell for the Yuzuha installer-enabled experience",
  "engines": {
    "node": ">=18 <=22"
  },
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "bundle": "react-native bundle --entry-file src/index.tsx --platform ios --dev false --bundle-output dist/main.jsbundle --assets-dest dist/assets",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "jest",
    "check-bundle": "ts-node src/installer/checkBundle.ts"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^1.20.1",
    "axios": "^1.6.0",
    "react": "19.2.0",
    "react-native": "0.83.0",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "^2.12.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/react": "^19.2.10",
    "@typescript-eslint/eslint-plugin": "^6.4.0",
    "@typescript-eslint/parser": "^6.4.0",
    "eslint": "^8.47.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.34.0",
    "jest": "^29.5.0",
    "metro-react-native-babel-preset": "^0.76.0",
    "@react-native/metro-config": "^0.83.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.7.0",
    "@react-native-community/cli": "latest"
  }
}
