<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/yuzuha_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#19272A"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/yuzuha_widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="#F4F7F5"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/yuzuha_widget_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/widget_summary_empty"
        android:textColor="#F4F7F5"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/widget_open_hint"
        android:textColor="#AEBDB7"
        android:textSize="12sp" />
</LinearLayout>
